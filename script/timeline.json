 "epilogue": [
  {
   "id": "E1",
   "text": "1981 年 1 月，葛洲坝截流。白鲟洄游的路被切断。"
  },
  {
   "id": "E2",
   "text": "2003 年 1 月 24 日，一尾长 3.52 米、腹中怀卵的雌性白鲟在宜宾被误捕。|救护人员为她缝合伤口，装上超声波信标，放归长江。"
  },
  {
   "id": "E3",
   "text": "1 月 30 日凌晨，跟踪船触礁，信号消失。|此后八年，科研人员一直在找她。"
  },
  {
   "id": "E4",
   "text": "那是人类最后一次见到白鲟。"
  },
  {
   "id": "E5",
   "text": "研究推断，白鲟在 2005 年至 2010 年间灭绝。"
  },
  {
   "id": "E6",
   "text": "没有人知道，最后一尾死在哪一天。"
  },
  {
   "id": "E7",
   "text": "2020 年 1 月 1 日，长江开始十年禁渔。"
  },
  {
   "id": "E8",
   "text": "她没有等到。"
  },
  {
   "id": "E9",
   "text": "2022 年 7 月 21 日，世界自然保护联盟宣布：白鲟灭绝。"
  }
 ]
