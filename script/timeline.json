 ],
 "lines": [
  {
   "id": "L01",
   "t": 10.5,
   "dur": 0.88,
   "who": "HER",
   "text": "喂。",
   "scene": "s0_cold"
  },
  {
   "id": "L02",
   "t": 13.18,
   "dur": 1.69,
   "who": "HER",
   "text": "你们还在听吗？",
   "scene": "s0_cold"
  },
  {
   "id": "L03",
   "t": 17.27,
   "dur": 2.85,
   "who": "HER",
   "text": "我知道，你们还在找我。",
   "scene": "s0_cold"
  },
  {
   "id": "L04",
   "t": 37.0,
   "dur": 2.995,
   "who": "HER",
   "text": "这条江的水，一直是黄的。",
   "scene": "s1_river"
  },
  {
   "id": "L05",
   "t": 41.495,
   "dur": 3.9,
   "who": "HER",
   "text": "我的眼睛很小。在这里，几乎没什么用。",
   "scene": "s1_river"
  },
  {
   "id": "L06",
   "t": 47.795,
   "dur": 1.4,
   "who": "HER",
   "text": "我用鼻子看。",
   "scene": "s1_river"
  },
  {
   "id": "L07",
   "t": 51.695,
   "dur": 3.92,
   "who": "HER",
   "text": "活着的东西，身上都有一点点电。",
   "scene": "s1_river"
  },
  {
   "id": "L08",
   "t": 56.715,
   "dur": 8.99,
   "who": "HER",
   "text": "小鱼，虾，石头缝里的虫。它们在黑暗里一闪一闪，像你们说的星星。",
   "scene": "s1_river"
  },
  {
   "id": "L09",
   "t": 67.705,
   "dur": 3.33,
   "who": "HER",
   "text": "这些年，我一直在找另外一颗。",
   "scene": "s1_river"
  },
  {
   "id": "L10",
   "t": 72.535,
   "dur": 1.68,
   "who": "HER",
   "text": "跟我一样大的。",
   "scene": "s1_river"
  },
  {
   "id": "L11",
   "t": 76.215,
   "dur": 2.71,
   "who": "HER",
   "text": "有时候，天会塌下来。",
   "scene": "s1_river"
  },
  {
   "id": "L12",
   "t": 88.525,
   "dur": 1.74,
   "who": "HER",
   "text": "那是你们的船。",
   "scene": "s1_river"
  },
  {
   "id": "L13",
   "t": 94.365,
   "dur": 1.77,
   "who": "HER",
   "text": "你们叫我白鲟。",
   "scene": "s2_scroll"
  },
  {
   "id": "L14",
   "t": 97.135,
   "dur": 4.75,
   "who": "HER",
   "text": "四川人叫我象鱼，因为我有一根长鼻子。",
   "scene": "s2_scroll"
  },
  {
   "id": "L15",
   "t": 104.285,
   "dur": 2.94,
   "who": "HER",
   "text": "一亿五千万年前，我们就在了。",
   "scene": "s2_scroll"
  },
  {
   "id": "L16",
   "t": 108.625,
   "dur": 3.25,
   "who": "HER",
   "text": "我们看着恐龙来，又看着它们走。",
   "scene": "s2_scroll"
  },
  {
   "id": "L17",
   "t": 112.875,
   "dur": 4.18,
   "who": "HER",
   "text": "那块把天烧红的石头，也没能杀死我们。",
   "scene": "s2_scroll"
  },
  {
   "id": "L18",
   "t": 118.455,
   "dur": 6.64,
   "who": "HER",
   "text": "山长高了，河改了道，冰来了又走。我们一直都在。",
   "scene": "s2_scroll"
  },
  {
   "id": "L19",
   "t": 126.495,
   "dur": 2.55,
   "who": "HER",
   "text": "后来，岸上有了人。",
   "scene": "s2_scroll"
  },
  {
   "id": "L20",
   "t": 130.245,
   "dur": 3.793,
   "who": "HER",
   "text": "三千年前，你们管我叫鲔。",
   "scene": "s2_scroll"
  },
  {
   "id": "L21",
   "t": 135.238,
   "dur": 5.29,
   "who": "HER",
   "text": "每年春天，天子要亲自坐船，把我们供进宗庙。",
   "scene": "s2_scroll"
  },
  {
   "id": "L22",
   "t": 141.728,
   "dur": 8.72,
   "who": "HER",
   "text": "人撒网，人写诗，人坐着船往下游去。那时候，江里到处都是我们。",
   "scene": "s2_scroll"
  },
  {
   "id": "L23",
   "t": 153.448,
   "dur": 4.07,
   "who": "HER",
   "text": "一九八一年，江中间，长出了一堵墙。",
   "scene": "s2_scroll"
  },
  {
   "id": "L24",
   "t": 158.518,
   "dur": 5.39,
   "who": "HER",
   "text": "墙下面的，上不来。墙上面的，下不去。",
   "scene": "s2_scroll"
  },
  {
   "id": "L25",
   "t": 165.108,
   "dur": 6.0,
   "who": "HER",
   "text": "我是在墙上面出生的。妈妈说，一直往下游，有海。",
   "scene": "s2_scroll"
  },
  {
   "id": "L26",
   "t": 171.908,
   "dur": 1.98,
   "who": "HER",
   "text": "我没见过海。",
   "scene": "s2_scroll"
  },
  {
   "id": "L27",
   "t": 175.088,
   "dur": 3.21,
   "who": "HER",
   "text": "后来，我们一年比一年少。",
   "scene": "s2_scroll"
  },
  {
   "id": "L28",
   "t": 182.998,
   "dur": 4.63,
   "who": "HER",
   "text": "二〇〇三年，一月。我撞进了一张网。",
   "scene": "s3_2003"
  },
  {
   "id": "L29",
   "t": 188.228,
   "dur": 2.3,
   "who": "HER",
   "text": "那是我第一次看见天。",
   "scene": "s3_2003"
  },
  {
   "id": "H01",
   "t": 191.428,
   "dur": 2.92,
   "who": "F1",
   "text": "我的妈呀，好大一条象鱼！",
   "scene": "s3_2003"
  },
  {
   "id": "H02",
   "t": 194.748,
   "dur": 1.46,
   "who": "F2",
   "text": "快去喊渔政的人来！",
   "scene": "s3_2003"
  },
  {
   "id": "H03",
   "t": 196.708,
   "dur": 3.53,
   "who": "F1",
   "text": "八个人都抬不动！拿棉被来，包起！",
   "scene": "s3_2003"
  },
  {
   "id": "L30",
   "t": 201.038,
   "dur": 2.4,
   "who": "HER",
   "text": "你们用棉被把我裹起来。",
   "scene": "s3_2003"
  },
  {
   "id": "L31",
   "t": 204.338,
   "dur": 1.14,
   "who": "HER",
   "text": "很暖。",
   "scene": "s3_2003"
  },
  {
   "id": "H04",
   "t": 206.678,
   "dur": 2.13,
   "who": "R1",
   "text": "雌性，三米五二。",
   "scene": "s3_2003"
  },
  {
   "id": "H05",
   "t": 210.008,
   "dur": 2.072,
   "who": "R1",
   "text": "……肚子里有卵。",
   "scene": "s3_2003"
  },
  {
   "id": "L32",
   "t": 213.48,
   "dur": 2.33,
   "who": "HER",
   "text": "你们给我缝了二十四针。",
   "scene": "s3_2003"
  },
  {
   "id": "L33",
   "t": 216.81,
   "dur": 3.76,
   "who": "HER",
   "text": "又在我背上，装了一个会叫的小东西。",
   "scene": "s3_2003"
  },
  {
   "id": "H06",
   "t": 221.77,
   "dur": 1.47,
   "who": "R1",
   "text": "放吧。",
   "scene": "s3_2003"
  },
  {
   "id": "L34",
   "t": 224.04,
   "dur": 4.58,
   "who": "HER",
   "text": "我先往下游游了一段。然后转过身，往上游走。",
   "scene": "s3_2003"
  },
  {
   "id": "H07",
   "t": 230.02,
   "dur": 3.011,
   "who": "B1",
   "text": "信号还在，往上游走了。",
   "scene": "s3_2003"
  },
  {
   "id": "H08",
   "t": 234.331,
   "dur": 2.919,
   "who": "B2",
   "text": "前面是金鸡尾，石头多，慢点！",
   "scene": "s3_2003"
  },
  {
   "id": "H09",
   "t": 238.55,
   "dur": 2.78,
   "who": "B1",
   "text": "信号……信号呢？",
   "scene": "s3_2003"
  },
  {
   "id": "L35",
   "t": 242.93,
   "dur": 5.02,
   "who": "HER",
   "text": "那天夜里，我在金鸡尾停下来，等了你们很久。",
   "scene": "s3_2003"
  },
  {
   "id": "L36",
   "t": 249.25,
   "dur": 1.58,
   "who": "HER",
   "text": "你们没有来。",
   "scene": "s3_2003"
  },
  {
   "id": "L37",
   "t": 255.13,
   "dur": 6.211,
   "who": "HER",
   "text": "背上那个小东西，又叫了很久。后来有一天，它不叫了。",
   "scene": "s4_seven"
  },
  {
   "id": "L38",
   "t": 262.641,
   "dur": 4.8,
   "who": "HER",
   "text": "那天我才知道，原来这些年，一直有个声音陪着我。",
   "scene": "s4_seven"
  },
  {
   "id": "L39",
   "t": 268.441,
   "dur": 5.49,
   "who": "HER",
   "text": "你们的船后来还来过。从我头顶开过去，好几次。",
   "scene": "s4_seven"
  },
  {
   "id": "L40",
   "t": 274.931,
   "dur": 1.45,
   "who": "HER",
   "text": "我就在下面。",
   "scene": "s4_seven"
  },
  {
   "id": "L41",
   "t": 277.381,
   "dur": 1.84,
   "who": "HER",
   "text": "你们听不见我。",
   "scene": "s4_seven"
  },
  {
   "id": "L42",
   "t": 285.821,
   "dur": 1.29,
   "who": "HER",
   "text": "……是你吗？",
   "scene": "s5_sturgeon"
  },
  {
   "id": "O01",
   "t": 291.811,
   "dur": 1.546,
   "who": "OLD",
   "text": "不是。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "O02",
   "t": 294.257,
   "dur": 1.71,
   "who": "OLD",
   "text": "你还在啊。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "L43",
   "t": 297.167,
   "dur": 4.15,
   "who": "HER",
   "text": "你最近，见过像我这样的吗？鼻子很长的。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "O03",
   "t": 302.617,
   "dur": 5.3,
   "who": "OLD",
   "text": "很多年前。那时候，江里到处都是你们。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "O04",
   "t": 309.117,
   "dur": 3.53,
   "who": "OLD",
   "text": "别往上走了。上面也没有。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "L44",
   "t": 313.547,
   "dur": 1.17,
   "who": "HER",
   "text": "我知道。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "O05",
   "t": 315.517,
   "dur": 1.57,
   "who": "OLD",
   "text": "那你还去？",
   "scene": "s5_sturgeon"
  },
  {
   "id": "L45",
   "t": 317.987,
   "dur": 3.56,
   "who": "HER",
   "text": "我肚子里有卵。它们得回到那里去。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "O06",
   "t": 323.447,
   "dur": 2.195,
   "who": "OLD",
   "text": "……那你慢慢游吧。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "L46",
   "t": 327.442,
   "dur": 4.97,
   "who": "HER",
   "text": "他也快没有了。我们都知道，谁也没说。",
   "scene": "s5_sturgeon"
  },
  {
   "id": "L47",
   "t": 338.212,
   "dur": 5.81,
   "who": "HER",
   "text": "宜宾。两条江在这里碰头。从这里往下，才叫长江。",
   "scene": "s6_yibin"
  },
  {
   "id": "L48",
   "t": 345.622,
   "dur": 6.98,
   "who": "HER",
   "text": "妈妈在这里生下我。她的妈妈也是。每一个春天，都是这样。",
   "scene": "s6_yibin"
  },
  {
   "id": "L49",
   "t": 355.602,
   "dur": 1.74,
   "who": "HER",
   "text": "我等了一整夜。",
   "scene": "s6_yibin"
  },
  {
   "id": "L50",
   "t": 359.142,
   "dur": 1.4,
   "who": "HER",
   "text": "没有谁来。",
   "scene": "s6_yibin"
  },
  {
   "id": "L51",
   "t": 363.242,
   "dur": 1.64,
   "who": "HER",
   "text": "我把它们放了。",
   "scene": "s6_yibin"
  },
  {
   "id": "L52",
   "t": 370.682,
   "dur": 5.38,
   "who": "HER",
   "text": "它们亮了一下。然后，一颗一颗，暗下去。",
   "scene": "s6_yibin"
  },
  {
   "id": "L53",
   "t": 383.662,
   "dur": 1.6,
   "who": "HER",
   "text": "我有点累了。",
   "scene": "s7_end"
  },
  {
   "id": "L54",
   "t": 387.662,
   "dur": 1.8,
   "who": "HER",
   "text": "你们还在听吗？",
   "scene": "s7_end"
  },
  {
   "id": "L55",
   "t": 392.162,
   "dur": 1.22,
   "who": "HER",
   "text": "别找了。",
   "scene": "s7_end"
  },
  {
   "id": "L56",
   "t": 396.182,
   "dur": 2.41,
   "who": "HER",
   "text": "今天的江水，也很暖。",
   "scene": "s7_end"
  }
 ],
